# CLOOP Pipeline Environment Variables Template
# ============================================================
# Usage:
#   1. Copy this file to ".env" in the same directory:
#        Copy-Item .env.example .env
#   2. Fill in the values below.
#   3. .env is gitignored - never committed to GitHub.
# ============================================================

# ── Gemini API ──────────────────────────────────────────────
# Google AI Studio API key (backend dedicated)
# Get it at: https://aistudio.google.com/apikey
# Recommended name: cloop-backend-pepp-us
GEMINI_API_KEY=PASTE_YOUR_AIza_KEY_HERE

# Gemini model (default recommended)
GEMINI_MODEL=gemini-2.5-flash

# ── Single-title mode (Stage 2 fallback, --all-titles 모드에서는 무시됨) ──
# Title ID (matches public/data/{TITLE_ID}.json filename)
CLOOP_TITLE_ID=pepp-us

# Local GDrive-sync creatives root folder (use backslash on Windows)
# Folder layout expected:
#   {ROOT}/01. BNR/{phase}/{creative_name}/[files]
#   {ROOT}/02. VID/{phase}/{creative_name}/[files]
CLOOP_CREATIVES_ROOT=G:\공유 드라이브\[펩 히어로즈] R마케팅실\01. UA\01. UA 소재

# ── Cache & Output ──────────────────────────────────────────
# Cache directory (relative to project root)
CACHE_DIR=cache

# Output JSON directory (auto-loaded by the dashboard)
OUTPUT_DIR=public/data

# ── Stage 4: Email Notifications (Optional) ─────────────────
# Configure SMTP to receive email alerts after nightly batch.
# If left empty, results will only be written to logs/ directory.
#
# ★ Gmail setup (recommended):
#   1. Enable 2FA at https://myaccount.google.com/security
#   2. Generate app password at https://myaccount.google.com/apppasswords
#   3. Use that 16-char password below
#
# ★ Office 365 setup (if SMTP AUTH allowed by your IT):
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@com2us.com
#   SMTP_PASSWORD=your_password
#   SMTP_FROM=yourname@com2us.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=chioyoon@com2us.com

# ── Stage 5: Google Ads API (Optional) ─────────────────────
# Path to OAuth credentials file (gitignored).
# Generated by: .\scripts\setup-google-ads.ps1
GOOGLE_ADS_CONFIG_PATH=.secrets/google_ads.yaml

# Rolling window of days to fetch (default 28)
GOOGLE_ADS_KPI_WINDOW_DAYS=28

# Single-title mode only (--all-titles uses titles.json fields).
# 10-digit customer ID without hyphens.
GOOGLE_ADS_CUSTOMER_ID=
# Comma-separated campaign name filter (optional)
GOOGLE_ADS_CAMPAIGN_FILTER=
