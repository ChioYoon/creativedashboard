# Com2uS R팀 CLOOP 대시보드 — .gitignore

# ─── 환경 변수 & 시크릿 ─────────────────────────
# 절대 커밋 금지 — Gemini API 키 포함
.env
.env.local
.env.*.local

# Stage 5: Google Ads OAuth refresh token, client_secret, developer_token 보관
.secrets/

# ─── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/

# ─── 파이프라인 캐시 ────────────────────────────
# SHA-256 캐시는 재생성 가능하므로 미커밋
cache/
*.cache.json

# ─── Stage 4 야간 배치 로그 ─────────────────────
# 매일 생성되는 로그는 30일 자동 회전됨 (미커밋)
logs/

# ─── 임시 산출물 ────────────────────────────────
*.tmp
*.bak
tmp/
*.zip
*.env.env

# ─── 에디터 ─────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── OS ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
